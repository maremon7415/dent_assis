# Lumadent environment template. Copy to .env and fill in. Never commit real values.
# NOTE: .gitignore currently ignores `.env*`; add `!.env.example` so this file is committed.

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dent_assis_dev

# ---- Auth (Clerk) ----
# Required in every environment since @clerk/nextjs 7 (its middleware no longer runs keyless).
# Local dev: use a development instance's keys (`npx clerk@latest init` writes temporary ones), e.g. in .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint (/api/webhooks/clerk): user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=
# "true" once Clerk Billing is enabled and the AI plans are published; otherwise the plan tables show a fallback.
NEXT_PUBLIC_CLERK_BILLING_ENABLED=false

# Comma-separated emails promoted to ADMIN on sign-in (only when the email is verified in Clerk).
ADMIN_EMAILS=owner@yourclinic.example,frontdesk@yourclinic.example
# Legacy single admin email; still honoured. Prefer ADMIN_EMAILS.
ADMIN_EMAIL=

# ---- Email (Resend) ----
# Without a key, emails are logged and skipped (bookings still work).
RESEND_API_KEY=
# Sender; the domain must be verified in Resend.
EMAIL_FROM="Lumadent <no-reply@yourclinic.example>"
NEXT_PUBLIC_SUPPORT_EMAIL=care@yourclinic.example

# ---- Clinic ----
# Absolute base URL used in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# IANA timezone every appointment date/time is interpreted in (e.g. Asia/Dhaka, America/New_York).
CLINIC_TIMEZONE=UTC
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CLINIC_PHONE="+1 (555) 010-2040"
NEXT_PUBLIC_CLINIC_ADDRESS="128 Harbor Street, Suite 4, Springfield"

# ---- Scheduled jobs ----
# Bearer secret for /api/cron/process-appointments (at least 16 characters; `openssl rand -hex 32`).
# The Netlify scheduled function sends it; set the same value in Netlify's environment variables.
CRON_SECRET=

# ---- AI voice assistant (Vapi) ----
NEXT_PUBLIC_VAPI_API_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
